# Performance Optimization Environment Variables
# Copy this file to .env.local and configure the values for your environment

# =====================================================
# REDIS CACHE CONFIGURATION
# =====================================================

# Redis server connection details
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Redis cache settings
REDIS_KEY_PREFIX=vitdaa_pos:
REDIS_DEFAULT_TTL=300

# Redis connection pool settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_CONNECTION_TIMEOUT=5000

# =====================================================
# PERFORMANCE MONITORING
# =====================================================

# Enable performance monitoring (set to 'true' in production if needed)
ENABLE_PERFORMANCE_MONITORING=false

# Performance thresholds (in milliseconds)
SLOW_API_THRESHOLD=1000
SLOW_DATABASE_THRESHOLD=500
SLOW_CACHE_THRESHOLD=50
SLOW_COMPONENT_THRESHOLD=100

# =====================================================
# DATABASE OPTIMIZATION
# =====================================================

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Query optimization settings
DB_QUERY_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=60000

# Enable query logging for slow queries
LOG_SLOW_QUERIES=false
SLOW_QUERY_THRESHOLD=1000

# =====================================================
# CACHING STRATEGY
# =====================================================

# Cache TTL settings (in seconds)
DASHBOARD_CACHE_TTL=60
STAFF_PERFORMANCE_CACHE_TTL=300
INVENTORY_ALERTS_CACHE_TTL=120
ORDER_QUEUE_CACHE_TTL=30
NOTIFICATIONS_CACHE_TTL=60
SESSION_CACHE_TTL=3600

# Cache invalidation settings
AUTO_INVALIDATE_CACHE=true
CACHE_INVALIDATION_DELAY=1000

# =====================================================
# LAZY LOADING CONFIGURATION
# =====================================================

# Default pagination settings
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Lazy loading thresholds
LAZY_LOAD_THRESHOLD=0.8
VIRTUAL_SCROLL_ITEM_HEIGHT=50
VIRTUAL_SCROLL_OVERSCAN=5

# =====================================================
# API OPTIMIZATION
# =====================================================

# API response compression
ENABLE_COMPRESSION=true
COMPRESSION_THRESHOLD=1024

# API rate limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# API caching headers
API_CACHE_CONTROL=public, max-age=60
API_ETAG_ENABLED=true

# =====================================================
# REAL-TIME OPTIMIZATION
# =====================================================

# WebSocket connection settings
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=1000

# Real-time data batching
REALTIME_BATCH_SIZE=10
REALTIME_BATCH_DELAY=100

# =====================================================
# MOBILE OPTIMIZATION
# =====================================================

# Mobile-specific cache settings
MOBILE_CACHE_TTL=30
MOBILE_PREFETCH_ENABLED=true
MOBILE_LAZY_LOAD_THRESHOLD=0.9

# Touch optimization
TOUCH_DEBOUNCE_DELAY=300
GESTURE_RECOGNITION_THRESHOLD=10

# =====================================================
# DEVELOPMENT SETTINGS
# =====================================================

# Development-only performance features
DEV_PERFORMANCE_OVERLAY=false
DEV_CACHE_DEBUGGING=false
DEV_QUERY_LOGGING=false

# Mock data for development
USE_MOCK_REDIS=false
USE_MOCK_PERFORMANCE_DATA=false

# =====================================================
# MONITORING AND ALERTING
# =====================================================

# Performance alerting thresholds
ALERT_ERROR_RATE_THRESHOLD=5
ALERT_RESPONSE_TIME_THRESHOLD=2000
ALERT_CACHE_MISS_RATE_THRESHOLD=50

# Health check intervals
HEALTH_CHECK_INTERVAL=30000
CACHE_HEALTH_CHECK_INTERVAL=60000

# Metrics collection
COLLECT_PERFORMANCE_METRICS=true
METRICS_RETENTION_DAYS=7

# =====================================================
# USAGE INSTRUCTIONS
# =====================================================

# 1. Copy this file to .env.local
# 2. Update the Redis connection details for your environment
# 3. Adjust cache TTL values based on your needs
# 4. Enable performance monitoring in production if needed
# 5. Configure database pool settings for your load
# 6. Test the configuration with your Redis instance

# =====================================================
# REDIS SETUP COMMANDS
# =====================================================

# For local development with Docker:
# docker run -d --name redis-vitdaa -p 6379:6379 redis:7-alpine

# For production, consider using Redis Cloud or AWS ElastiCache:
# - Redis Cloud: https://redis.com/redis-enterprise-cloud/
# - AWS ElastiCache: https://aws.amazon.com/elasticache/
# - Azure Cache for Redis: https://azure.microsoft.com/en-us/services/cache/

# =====================================================
# PERFORMANCE TESTING
# =====================================================

# Load testing settings
LOAD_TEST_CONCURRENT_USERS=50
LOAD_TEST_DURATION=300
LOAD_TEST_RAMP_UP=60

# Stress testing thresholds
STRESS_TEST_MAX_MEMORY=512
STRESS_TEST_MAX_CPU=80
STRESS_TEST_MAX_CONNECTIONS=100